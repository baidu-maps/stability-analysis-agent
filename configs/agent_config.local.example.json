{
  "_comment": "复制本文件为 agent_config.local.json 并填入真实密钥。llm_config.mode 只有 fixed 和 auto：fixed 只用 active_provider 指向的那一条（与历史行为一致）；auto 扫描 providers 中密钥有效的厂商，由内置策略分 default/strong/fast 并按阶段选用。routing.failover_enabled 控制调用失败是否切换；preferences 仅在健康池内作偏好。请只保留已填真实密钥的 providers 条目（占位符 YOUR_* 不会被 auto 选中）。",
  "_provider_guide": {
    "required_fields": ["model", "base_url", "auth_type"],
    "auth_type": "api_key | authorization | none",
    "common_optional_fields": [
      "api_key",
      "authorization",
      "api_key_env",
      "auth_header",
      "auth_prefix",
      "request_timeout",
      "request_format",
      "stream"
    ],
    "request_format_enum": [
      "openai_chat_completions_compatible",
      "anthropic_messages_compatible",
      "openai_responses_compatible",
      "minimax_text_chatcompletion_v2_compatible",
      "custom_unsupported_need_adapter"
    ],
    "notes": "公共配置放在 llm_config.provider_defaults；providers 下各厂商条目只写差异字段。接口请求地址对应 base_url，须为完整 URL（仅去除末尾 /）。本文件不在 providers 内放置仅占位的自定义键（如 your_*），以免用户复制为 agent_config.local.json 后，交互 CLI 的「请选择大模型厂商」菜单多出无关项；自建网关或 OpenAI Responses 等示例见 docs/cli/CLI_GUIDE.md「自定义厂商与示例文件说明」及「多协议最小配置示例」。",
    "request_format_notes": {
      "openai_chat_completions_compatible": "请求体为 model+messages，典型路径: /v1/chat/completions",
      "anthropic_messages_compatible": "请求体为 model+messages(+system)，典型路径: /v1/messages；通常使用 x-api-key 且 auth_prefix 为空字符串",
      "openai_responses_compatible": "请求体为 model+input，典型路径: /v1/responses",
      "minimax_text_chatcompletion_v2_compatible": "按 OpenAI Chat Completions 兼容方式发送，通常用于 MiniMax 网关兼容路由"
    },
    "stream_notes": "true（默认）使用 SSE 流式调用，与厂商 Web UI 相同的响应速度；设为 false 使用非流式调用。所有 openai_chat_completions_compatible 厂商（OpenAI/DeepSeek/GLM/千帆/通义千问/Kimi/MiniMax）均支持流式；anthropic_messages_compatible 和 openai_responses_compatible 不受此参数影响（使用各自的 HTTP 调用）。"
  },
  "llm_config": {
    "mode": "fixed",
    "active_provider": "openai",
    "routing": {
      "failover_enabled": false,
      "health_check": true
    },
    "preferences": {
      "default_provider": null,
      "strong_provider": null
    },
    "provider_defaults": {
      "request_format": "openai_chat_completions_compatible",
      "auth_type": "api_key",
      "auth_header": "Authorization",
      "auth_prefix": "Bearer ",
      "adapter_provider": "openai",
      "request_timeout": 180,
      "stream": true
    },
    "providers": {
      "openai": {
        "api_key": "YOUR_OPENAI_API_KEY",
        "api_key_env": ["OPENAI_API_KEY"],
        "base_url": "https://api.openai.com/v1/chat/completions",
        "model": "gpt-4o"
      },
      "deepseek": {
        "api_key": "YOUR_DEEPSEEK_API_KEY",
        "api_key_env": ["DEEPSEEK_API_KEY"],
        "adapter_provider": "deepseek",
        "base_url": "https://api.deepseek.com/v1/chat/completions",
        "model": "deepseek-chat"
      },
      "zhipu_bigmodel": {
        "api_key": "YOUR_ZHIPU_API_KEY",
        "api_key_env": ["ZHIPU_API_KEY", "BIGMODEL_API_KEY"],
        "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
        "model": "glm-4"
      },
      "baidu_qianfan": {
        "auth_type": "authorization",
        "authorization": "YOUR_BAIDU_QIANFAN_AUTHORIZATION",
        "api_key_env": ["BAIDU_QIANFAN_AUTHORIZATION"],
        "adapter_provider": "baidu_qianfan",
        "base_url": "https://qianfan.baidubce.com/v2/chat/completions",
        "model": "ernie-4.0-8k"
      },
      "qwen": {
        "api_key": "YOUR_DASHSCOPE_API_KEY",
        "api_key_env": ["DASHSCOPE_API_KEY", "QWEN_API_KEY"],
        "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
        "model": "qwen-plus"
      },
      "kimi": {
        "api_key": "YOUR_MOONSHOT_API_KEY",
        "api_key_env": ["MOONSHOT_API_KEY", "KIMI_API_KEY"],
        "base_url": "https://api.moonshot.cn/v1/chat/completions",
        "model": "moonshot-v1-8k"
      },
      "minimax": {
        "api_key": "YOUR_MINIMAX_API_KEY",
        "api_key_env": ["MINIMAX_API_KEY"],
        "base_url": "https://api.minimaxi.com/v1/chat/completions",
        "model": "MiniMax-M2.5"
      },
      "claude": {
        "api_key": "YOUR_ANTHROPIC_API_KEY",
        "api_key_env": ["ANTHROPIC_API_KEY"],
        "request_format": "anthropic_messages_compatible",
        "auth_header": "x-api-key",
        "auth_prefix": "",
        "base_url": "https://api.anthropic.com/v1/messages",
        "model": "claude-sonnet-4-20250514"
      },
      "xiaomi": {
        "api_key": "YOUR_XIAOMI_API_KEY",
        "api_key_env": ["XIAOMI_API_KEY"],
        "request_format": "custom_unsupported_need_adapter",
        "base_url": "https://api.mi.com/llm/v1/chat/completions",
        "model": "mi-plus"
      }
    }
  },
  "workflow_config": {
    "streaming_response": true,
    "code_context_timeout_sec": 600,
    "find_source_timeout_sec": 600
  }
}
